# Copier en .env (ou exporter ces variables avant de lancer les services).
# Toutes les valeurs ci-dessous sont des valeurs par défaut sûres pour le
# câblage décrit dans Tilemse.docx — à adapter si le câblage réel diffère.

# Backend en ligne (enrôlement + heartbeat). Laisser tel quel en prod.
MAHALI_API_BASE=https://api.mikia-green.com

# ============================================================================
#  ÉCRAN 3,5" SPI (chapeau GPIO) — DÉCOMMENTER TOUT ce bloc si tu l'utilises.
#  On regroupe TOUS les relais + le HC-SR04 sur les broches "hautes" (GPIO 4 à
#  26) qu'AUCUN écran 3,5" n'utilise -> zéro conflit, quel que soit le modèle.
#  L'écran garde le SPI (GPIO 7/8/9/10/11 + 24/25) et l'I2C reste sur 2/3.
#  Correspondance broche physique entre parenthèses (voir docs/BRANCHEMENT.md).
# ----------------------------------------------------------------------------
# MAHALI_RELAY1_PIN=5     # pin 29  (pompe principale)
# MAHALI_RELAY2_PIN=6     # pin 31
# MAHALI_RELAY3_PIN=12    # pin 32
# MAHALI_RELAY4_PIN=13    # pin 33
# MAHALI_RELAY5_PIN=16    # pin 36
# MAHALI_RELAY6_PIN=19    # pin 35
# MAHALI_RELAY7_PIN=20    # pin 38
# MAHALI_RELAY8_PIN=21    # pin 40  (pompes canari)
# MAHALI_HCSR04_TRIG_PIN=26   # pin 37
# MAHALI_HCSR04_ECHO_PIN=4    # pin 7  (via pont diviseur 5V->3,3V)
# ============================================================================

# Simulation (mettre à true sur une machine de dev sans matériel) :
MAHALI_SIMULATE=false

# Broker MQTT (Mosquitto, cf. docker-compose.yml du backend) :
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=mahali

# I2C :
MAHALI_I2C_BUS=1
MAHALI_TCA9548A_ADDR=0x70
MAHALI_BME280_ADDR=0x76
MAHALI_ADS1115_ADDR=0x48
MAHALI_ADS1115_PH_CHANNEL=0
MAHALI_PH_NEUTRAL_VOLTAGE=2.5
MAHALI_PH_SLOPE=0.1776

# HC-SR04 (niveau du réservoir 1000 L) :
MAHALI_HCSR04_TRIG_PIN=23
MAHALI_HCSR04_ECHO_PIN=24
MAHALI_TANK_EMPTY_DISTANCE_CM=100.0
MAHALI_TANK_FULL_DISTANCE_CM=10.0

# Relais (8 canaux, module actif à l'état BAS) :
MAHALI_RELAY_ACTIVE_LOW=true
MAHALI_RELAY1_PIN=17
MAHALI_RELAY2_PIN=27
MAHALI_RELAY3_PIN=22
MAHALI_RELAY4_PIN=10
MAHALI_RELAY5_PIN=9
MAHALI_RELAY6_PIN=11
MAHALI_RELAY7_PIN=5
MAHALI_RELAY8_PIN=6

# Règles d'automatisation :
MAHALI_AUTOMATION_TEMP_HIGH=32.0
MAHALI_AUTOMATION_TEMP_LOW_RESET=28.0
MAHALI_MAIN_PUMP_ON_S=900
MAHALI_MAIN_PUMP_OFF_S=900
MAHALI_WATER_LEVEL_LOW=20.0
MAHALI_WATER_LEVEL_CRITICAL=5.0

# Cadence :
MAHALI_SENSOR_INTERVAL_S=10.0
MAHALI_AUTOMATION_TICK_S=5.0
