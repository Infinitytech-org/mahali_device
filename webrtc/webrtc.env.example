# Copier en /etc/mahali/webrtc.env sur le Pi, puis renseigner.
# Source MJPEG de l'ESP32-CAM (mDNS conseille : survit aux changements d'IP DHCP).
ESP32_STREAM_URL=http://mahali-cam.local:81/stream

# Cible RTSP (mediamtx sur le NOUVEAU serveur). Le mot de passe reste ici, hors du code.
# Remplacer PUBLISH_PASS et NOUVEAU_SERVEUR.
MEDIAMTX_RTSP_URL=rtsp://mahali-pi:PUBLISH_PASS@NOUVEAU_SERVEUR:8554/serre-s001

# Qualite / charge
FPS=12
BITRATE=700k
GOP=24
