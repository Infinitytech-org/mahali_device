# Service systemd : pousse la caméra ESP32 vers mediamtx (WebRTC).
# Installation sur le Pi :
#   sudo cp push_cam.sh /usr/local/bin/mahali-push-cam && sudo chmod +x /usr/local/bin/mahali-push-cam
#   sudo mkdir -p /etc/mahali && sudo cp webrtc.env.example /etc/mahali/webrtc.env  # puis renseigner
#   sudo cp mahali-webrtc-push.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mahali-webrtc-push
#   journalctl -u mahali-webrtc-push -f
[Unit]
Description=Mahali - pousseur camera ESP32 vers mediamtx (WebRTC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/mahali/webrtc.env
ExecStart=/usr/local/bin/mahali-push-cam
Restart=always
RestartSec=3
# Redemarre indefiniment si l'ESP32 ou le reseau tombe.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
